# Required by worker and dashboard. Render supplies this from promo-db in render.yaml.
DATABASE_URL=postgres://user:password@host:5432/promo_monitor

# GitHub auth. Use either one token or a comma-separated token pool.
GITHUB_TOKEN=
GITHUB_TOKENS=

# Optional low-cost structured extraction. Worker skips LLM pass when neither is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Alert channels; every unset channel is skipped cleanly.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_URL=
EMAIL_FROM=promo-monitor@example.com
EMAIL_TO=

# Dashboard admin mutation protection.
ADMIN_SECRET=change-me-long-random-string

# Worker tuning (defaults are safe for one token).
FAST_LANE_INTERVAL_MS=90000
SLOW_LANE_INTERVAL_MS=1200000
WATCHLIST_INTERVAL_MS=300000
SEARCH_PAGE_SIZE=30
MAX_COMMIT_DETAILS_PER_SCAN=3
MAX_CODE_FILES_PER_SCAN=3
BACKFILL_ENABLED=true
BACKFILL_DAYS_PER_WINDOW=7
BACKFILL_START_DATE=
BACKFILL_STOP_DATE=2020-01-01
BACKFILL_MINIMUM_RATE_LIMIT_PERCENT=30
LIVE_MINIMUM_RATE_LIMIT_PERCENT=3

# Runtime metadata used in logs and health displays.
APP_ENV=production
