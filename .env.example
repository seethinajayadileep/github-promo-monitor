# Required by worker and dashboard. Render supplies this from promo-db in render.yaml.
DATABASE_URL=postgres://user:password@host:5432/promo_monitor

# GitHub auth. Use either one token or a comma-separated token pool.
GITHUB_TOKEN=
GITHUB_TOKENS=

# Optional structured extraction. The worker skips the LLM pass when no key is set.
# OPENAI_API_KEY selects GPT-6 Luna (gpt-6-luna) and wins over Sarvam and Gemini.
# Sarvam 105B is the fallback when only SARVAM_API_KEY is set. Do not commit a real key.
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai/v2/chat/completions
SARVAM_MODEL=sarvam-105b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_COMPLETION_TOKENS=1024
OPENAI_TIMEOUT_MS=30000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional Exa discovery lane. Leave EXA_API_KEY empty to skip the lane.
# Requests are limited to github.com. There is no second page (max 100 results).
# auto allows contents.maxAgeHours; lite is cache-only and rejects that field.
EXA_API_KEY=
EXA_SEARCH_TYPE=auto
EXA_NUM_RESULTS=10
EXA_MAX_AGE_HOURS=24
EXA_PUBLISHED_WITHIN_DAYS=21
EXA_INTERVAL_MS=1800000
EXA_TIMEOUT_MS=30000

# Alert channels; every unset channel is skipped cleanly.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SMTP_URL=
EMAIL_FROM=promo-monitor@example.com
EMAIL_TO=

# Dashboard admin mutation protection.
ADMIN_SECRET=change-me-long-random-string

# Worker tuning (defaults are safe for one token).
FAST_LANE_INTERVAL_MS=90000
SLOW_LANE_INTERVAL_MS=1200000
WATCHLIST_INTERVAL_MS=300000
SEARCH_PAGE_SIZE=100
MAX_COMMIT_DETAILS_PER_SCAN=80
MAX_CODE_FILES_PER_SCAN=40
MAX_COMMIT_SEARCH_PAGES=10
MAX_ISSUE_SEARCH_PAGES=10
MAX_CODE_SEARCH_PAGES=5
LIVE_COMMIT_WINDOW_DAYS=21
MAX_FOLLOWED_REPOS_PER_SCAN=30
FOLLOWED_REPO_COMMIT_PAGE_SIZE=30
MAX_FOLLOWED_COMMIT_DETAILS_PER_REPO=15
MAX_FOLLOWED_COMMIT_DETAILS_PER_SCAN=60
SCAN_RUN_RETENTION_DAYS=7
BACKFILL_ENABLED=true
BACKFILL_DAYS_PER_WINDOW=7
BACKFILL_START_DATE=
BACKFILL_STOP_DATE=2020-01-01
BACKFILL_MINIMUM_RATE_LIMIT_PERCENT=30
LIVE_MINIMUM_RATE_LIMIT_PERCENT=3
BACKFILL_INTERVAL_MS=1800000

# Runtime metadata used in logs and health displays.
APP_ENV=production
